# Copy to .env and uncomment what you need. Priority: environment variable >
# .env > default in src/config.py. Format: RAG_<GROUP>__<FIELD>.

# Corpus root and index directory.
# RAG_PATHS__RAW_DIR=data/raw
# RAG_PATHS__PROCESSED_DIR=data/processed

# Ranker: lexical (BM25), semantic or hybrid; the last two need
# `index --semantic`.
# RAG_RETRIEVAL__MODE=lexical
# RAG_RETRIEVAL__DEFAULT_K=10

# Weight precision: float32 or bfloat16 (~1.8x faster on CPUs with native
# bf16, can be slower without it).
# RAG_GENERATION__DTYPE=float32
# RAG_EMBEDDING__DTYPE=float32

# Answer model and its prompt budget.
# RAG_GENERATION__MODEL=Qwen/Qwen3-0.6B
# RAG_GENERATION__MAX_CONTEXT_TOKENS=1500
# RAG_GENERATION__MAX_NEW_TOKENS=200

# BM25 parameters (used by `index`).
# RAG_BM25__K1=1.5
# RAG_BM25__B=0.75
